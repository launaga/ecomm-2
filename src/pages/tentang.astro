---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LocalBusinessSchema from '@/components/LocalBusinessSchema.astro';
import LocationBlock from '@/components/LocationBlock.astro';
import { site } from '@/config/site';

/**
 * Team data (PRD F-A2). Placeholder — CLIENT to replace with real staff.
 * Photos are optional; a monogram avatar is shown when photo is empty.
 */
const team = [
  {
    name: '[Nama Kepala Mekanik]',
    role: 'Kepala Mekanik',
    experience: '15 tahun',
    specialization: 'Mesin & modifikasi',
    photo: '',
  },
  {
    name: '[Nama Mekanik]',
    role: 'Mekanik',
    experience: '8 tahun',
    specialization: 'Kelistrikan & injeksi',
    photo: '',
  },
  {
    name: '[Nama Front Desk]',
    role: 'Service Advisor',
    experience: '5 tahun',
    specialization: 'Konsultasi & estimasi',
    photo: '',
  },
];

function initials(name: string) {
  return name
    .replace(/[[\]]/g, '')
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();
}
---

<BaseLayout
  title={`Tentang ${site.name}`}
  description={`Cerita, tim, dan lokasi ${site.name} — bengkel motor di ${site.city}. Alamat, jam buka, dan kontak WhatsApp.`}
>
  <LocalBusinessSchema slot="head" />

  <section class="section">
    <div class="container" style="max-width: 46rem;">
      <p class="eyebrow">Tentang Kami</p>
      <h1>{site.name}</h1>
      <p class="lede">
        {site.legalName} berdiri sejak <strong>[TAHUN]</strong> di {site.city}.
        Kami spesialis servis, sparepart, dan modifikasi motor — mengerjakan
        dari perawatan harian sampai custom build.
      </p>
      <p class="muted">
        [CLIENT: ceritakan latar belakang bengkel, filosofi kerja, dan
        keahlian utama di sini. Ceritakan kenapa pelanggan bisa percaya
        menyerahkan motornya.]
      </p>
    </div>
  </section>

  <!-- Team (PRD F-A2) -->
  <section class="section section--muted">
    <div class="container">
      <h2>Tim Kami</h2>
      <div class="grid grid--3">
        {
          team.map((m) => (
            <article class="card member">
              <div class="member__avatar" aria-hidden="true">
                {m.photo ? (
                  <img src={m.photo} alt={m.name} width="72" height="72" />
                ) : (
                  <span>{initials(m.name)}</span>
                )}
              </div>
              <div class="member__body">
                <h3>{m.name}</h3>
                <div class="muted">{m.role}</div>
                <div class="chips">
                  <span class="chip">{m.experience}</span>
                  <span class="chip">{m.specialization}</span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact block (PRD F-A4) -->
  <section class="section">
    <div class="container">
      <h2>Kunjungi Kami</h2>
      <LocationBlock />
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    font-size: 1.15rem;
  }
  .member {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
  }
  .member__avatar {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    border-radius: 999px;
    background: var(--c-brand);
    color: var(--c-brand-ink);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 1.4rem;
    overflow: hidden;
  }
  .member__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .member__body h3 {
    margin: 0;
  }
</style>
