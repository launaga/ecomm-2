---
import { waLink, waMessages } from '@/lib/whatsapp';

/**
 * Sticky WhatsApp FAB on all routes/viewports (PRD F-G1).
 * Fires `wa_click` with source_page via the analytics data attributes.
 */
const href = waLink(waMessages.general());
---

<a
  class="wa-fab"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Chat WhatsApp"
  data-analytics="wa_click"
  data-source="fab"
>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" fill="currentColor">
    <path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.6c1.7.9 3.7 1.4 5.8 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-4.9 1 1-4.8-.3-.4c-1-1.6-1.5-3.4-1.5-5.3C4.8 9.9 9.9 5.2 16 5.2c6.1 0 10.8 4.9 10.8 10.8S22.1 24.8 16 24.8zm6-8.1c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.2s-.8 1-1 1.2c-.2.2-.4.2-.7.1-1.8-.9-3-1.6-4.2-3.6-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.6s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 2.9s1.2 3.4 1.4 3.6c.2.2 2.5 3.8 6 5.3 2.2.9 3 1 4.1.9.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z"/>
  </svg>
  <span class="wa-fab__text">Chat WhatsApp</span>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--c-wa);
    color: #05391a;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    box-shadow: var(--shadow-lg);
  }
  .wa-fab:hover {
    text-decoration: none;
  }
  .wa-fab__text {
    font-size: 0.9rem;
  }
  /* On the smallest screens, show a compact icon-only pill to save space. */
  @media (max-width: 400px) {
    .wa-fab__text {
      display: none;
    }
    .wa-fab {
      padding: 0.85rem;
    }
  }
</style>
