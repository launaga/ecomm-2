---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

/** Portfolio project card (PRD F-P1). */
interface Props {
  project: CollectionEntry<'projects'>;
  loading?: 'lazy' | 'eager';
}
const { project, loading = 'lazy' } = Astro.props;
const p = project.data;
---

<article class="card project-card">
  <a href={`/portofolio/${project.id}`} class="card__img" aria-label={p.title}>
    <Image
      src={p.cover}
      alt={`${p.title} — ${p.bikeModel}`}
      widths={[360, 720]}
      sizes="(min-width: 640px) 360px, 90vw"
      loading={loading}
    />
    <span class="project-card__tag">{p.projectType}</span>
  </a>
  <div class="card__body">
    <h3 class="card__title">
      <a href={`/portofolio/${project.id}`}>{p.title}</a>
    </h3>
    <div class="muted">{p.bikeModel} · {p.year}</div>
  </div>
</article>

<style>
  .card__img {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    background: var(--c-surface);
    overflow: hidden;
  }
  .card__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-card__tag {
    position: absolute;
    left: 0.6rem;
    top: 0.6rem;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
  .card__title {
    font-size: 1.05rem;
    margin: 0;
  }
  .card__title a {
    color: var(--c-text);
  }
</style>
