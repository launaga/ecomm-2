---
import { site } from '@/config/site';

/**
 * Lazy map facade (PRD T5, F-H4): renders a static placeholder button and only
 * injects the Google Maps iframe on interaction, so a heavy third-party iframe
 * never blocks LCP.
 */
---

<div class="map" data-map-embed data-src={site.mapsEmbedUrl}>
  <button type="button" class="map__facade" aria-label="Tampilkan peta lokasi">
    <span class="map__pin" aria-hidden="true">📍</span>
    <span>Lihat Peta Lokasi</span>
    <small class="muted">{site.address.street}, {site.address.city}</small>
  </button>
</div>

<style>
  .map {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .map__facade {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    background:
      repeating-linear-gradient(
        45deg,
        var(--c-surface),
        var(--c-surface) 12px,
        #ececeb 12px,
        #ececeb 24px
      );
    border: 0;
    cursor: pointer;
    font-weight: 600;
    color: var(--c-text);
  }
  .map__pin {
    font-size: 2rem;
  }
  .map :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-map-embed]')
    .forEach((wrap) => {
      const btn = wrap.querySelector('button');
      const src = wrap.dataset.src;
      if (!btn || !src) return;
      btn.addEventListener(
        'click',
        () => {
          const iframe = document.createElement('iframe');
          iframe.src = src;
          iframe.loading = 'lazy';
          iframe.referrerPolicy = 'no-referrer-when-downgrade';
          iframe.title = 'Peta lokasi bengkel';
          wrap.replaceChildren(iframe);
        },
        { once: true },
      );
    });
</script>
